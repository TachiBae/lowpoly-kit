{
  "name": "lowpoly-kit",
  "version": "0.1.0",
  "description": "Code-generated 3D low-poly characters, motion and sets for vertical videos (Remotion + react-three-fiber).",
  "scripts": {
    "dev": "remotion studio",
    "example": "remotion render ExampleShort out/example.mp4 --gl=angle",
    "gallery": "remotion still KitGallery out/kit-gallery.png --gl=angle --frame=30",
    "actlab": "remotion render ActLab out/actlab.mp4 --gl=angle",
    "gesturelab": "remotion render GestureLab out/gesturelab.mp4 --gl=angle",
    "stills": "node tools/stills.mjs",
    "check": "tsc --noEmit -p . && node tools/motion-check.mjs && node tools/walk-check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/captions": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "@remotion/three": "4.0.543",
    "n8ao": "2.0.2",
    "postprocessing": "6.39.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "license": "MIT",
  "keywords": [
    "remotion",
    "three.js",
    "react-three-fiber",
    "low-poly",
    "animation",
    "shorts",
    "procedural-characters"
  ]
}
